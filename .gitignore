# Raw pack images live on Azure, not git. Existing packs/<template>/pack.zip
# files stay tracked (small, 3-12MB each); only loose source images are
# ignored. Pattern catches packs/mbti-character/, packs/vocabulary/, etc.
packs/**/*.jpg
packs/**/*.jpeg
packs/**/*.png
packs/**/*.webp
public/blog-assets/

# SKU-mode pack bundles are large (Azure-only); template-mode packs/template-*/pack.zip stays tracked.
packs/**/*.pdf
packs/herbal/pack.zip
packs/hsk-reading/pack.zip
packs/vocab-scenes/pack.zip
packs/travel-maps/pack.zip
packs/world-costumes/pack.zip
packs/cuisine-cards/pack.zip
packs/zhenhuan-mbti/pack.zip
packs/confused-chinese-words/pack.zip

# design-agent trajectory capture (local sink; may contain query text)
.trajectories/
