# Raw pack images live on Azure, not git. Existing packs/<template>/pack.zip
# files stay tracked (small, 3-12MB each); only loose source images are
# ignored. Pattern catches packs/mbti-character/, packs/vocabulary/, etc.
packs/**/*.jpg
packs/**/*.jpeg
packs/**/*.png
packs/**/*.webp
public/blog-assets/

# SKU-mode pack bundles are large (Azure-only); template-mode packs/template-*/pack.zip stays tracked.
packs/**/*.pdf
